# Copy to `.env` for local runs (never commit the real .env).
# On Render, set these same keys in Dashboard → Service → Environment.

# REQUIRED — Postgres connection string (Neon: Dashboard → project →
# Connect → Connection string). Placeholder only, not a real credential.
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/dbname?sslmode=require

# REQUIRED for the first boot — becomes the first Admin's login Key.
# Choose your own long random value; it is only used while the users
# table is empty. There is no default and no hardcoded key anywhere.
ADMIN_KEY=change-me-choose-your-own-admin-key

# Optional — display name of the seeded first Admin.
ADMIN_NAME=Admin

# Optional — external AI question generation (OpenAI-compatible API).
# Leave AI_API_KEY empty/unset to use the built-in local template
# generator derived from the teacher's material (free, always works).
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Server port (Render sets PORT automatically).
PORT=3000
