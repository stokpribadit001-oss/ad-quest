{
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "description": "AD QUEST \u2014 platform ujian sekolah (Admin, Guru, Pengawas, Siswa). Standalone deploy for Render Free + Neon Postgres.",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-safe-area": "^1.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "ad-quest",
  "private": true,
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist-server/index.js",
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "migrate": "tsx server/src/migrate-cli.ts",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "1.0.0"
}